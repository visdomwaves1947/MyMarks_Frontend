{
  "redirects": [
    {
      "source": "/mymarks/maths",
      "destination": "/maths",
      "permanent": true
    },
    {
      "source": "/mymarks/demo",
      "destination": "/demo",
      "permanent": true
    },
    {
      "source": "/mymarks/english",
      "destination": "/english",
      "permanent": true
    },
    {
      "source": "/mymarks/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://mymarks-backend.vercel.app/sitemap.xml"
    },
    {
      "source": "/courses/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|skypeuripreview|pinterest).*"
        }
      ],
      "destination": "https://mymarks-backend.vercel.app/share/courses/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
